{
  "name": "Onboarding Employés",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -240,
        0
      ],
      "id": "3fc0e959-a502-4646-8ea8-f1083b0dfc70",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.fields.Email }}",
        "subject": "=Bienvenue {{ $json.fields.Nom }} !",
        "emailType": "text",
        "message": "=Bonjour {{ $json.fields.Nom }},  Bienvenue dans l'équipe ! Nous sommes ravis de vous compter parmi nous pour le poste de {{ $json.fields.Poste }}.  À très bientôt, L'équipe RH",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        176,
        0
      ],
      "id": "b80c8d87-6c2a-4016-a510-6412a0a90927",
      "name": "Send a message",
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "YOUR_AIRTABLE_TABLE_ID",
          "mode": "id"
        },
        "filterByFormula": "{Statut} = 'Nouveau'",
        "options": {}
      },
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "id": "3779a151-03d1-4fc8-8a0e-ff976dd53b01",
      "name": "Search records",
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "operation": "copy",
        "fileId": {
          "__rl": true,
          "value": "https://docs.google.com/document/d/YOUR_TEMPLATE_DOC_ID/edit",
          "mode": "url"
        },
        "name": "=Attestation - {{ $json.fields.Nom }}",
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        352,
        0
      ],
      "id": "b9baef69-3306-4a1e-8d45-a65897cd551b",
      "name": "Copy file",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentURL": "={{ $json.id }}",
        "actionsUi": {
          "actionFields": [
            {
              "action": "replaceAll",
              "text": "=[Nom]",
              "replaceText": "={{ $('Search records').item.json.fields.Nom }}"
            },
            {
              "action": "replaceAll",
              "text": "[Poste]",
              "replaceText": "={{ $('Search records').item.json.fields.Poste }}"
            },
            {
              "action": "replaceAll",
              "text": "[DateEntree]",
              "replaceText": "={{ $('Search records').item.json.fields['Date d\\'entrée'] }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        608,
        0
      ],
      "id": "842d8f46-e73c-4585-b12f-6bdac58837cb",
      "name": "Update a document",
      "credentials": {
        "googleDocsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Google Docs account"
        }
      }
    }
  ],
  "connections": {
    "Send a message": {
      "main": [
        [
          {
            "node": "Copy file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search records": {
      "main": [
        [
          {
            "node": "Send a message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When clicking ‘Execute workflow’": {
      "main": [
        [
          {
            "node": "Search records",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Copy file": {
      "main": [
        [
          {
            "node": "Update a document",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": false
  },
